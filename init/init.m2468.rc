# Enable all gesture
on post-fs-data
    chmod 0777 /sys/devices/platform/mx-gs/gesture_control

on property:sys.boot_completed=1
    start mz_gesture_control_init

service mz_gesture_control_init /vendor/bin/mz_fp_gesture_init
    class late_start
    user system
    group system
    disabled
    oneshot

# A killed HAL cannot run its wrapper cleanup. Reset the panel from init as
# well, including the restart interval before the module is loaded again.
on property:init.svc.anc_fps=stopped
    write /sys/kernel/display_drivers/hbm 7

on property:init.svc.anc_fps=restarting
    write /sys/kernel/display_drivers/hbm 7
